


RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' 

echo "=== Creating Docker Compose Symlinks ==="
echo ""
echo "This script will create symlinks from the root directory to the Docker files in docker/"
echo "This is only necessary if you need backward compatibility with scripts"
echo "that directly reference docker-compose.yml in the root directory."
echo ""
echo -e "${YELLOW}Warning: This will overwrite any existing files with the same names in the root directory.${NC}"
echo ""
read -p "Do you want to continue? (y/n) " answer

if [[ $answer != "y" && $answer != "Y" ]]; then
    echo "Operation cancelled."
    exit 0
fi


if [ -f "docker-compose.yml" ]; then
    rm docker-compose.yml
fi
ln -s docker/docker-compose.yml docker-compose.yml
echo -e "${GREEN}✅ Created symlink for docker-compose.yml${NC}"

if [ -f "docker-compose.gpu.yml" ]; then
    rm docker-compose.gpu.yml
fi
ln -s docker/docker-compose.gpu.yml docker-compose.gpu.yml
echo -e "${GREEN}✅ Created symlink for docker-compose.gpu.yml${NC}"

if [ -f "docker-compose.prod.yml" ]; then
    rm docker-compose.prod.yml
fi
ln -s docker/docker-compose.prod.yml docker-compose.prod.yml
echo -e "${GREEN}✅ Created symlink for docker-compose.prod.yml${NC}"


if [ "$(uname)" = "Darwin" ]; then
    if [ -f "docker-compose.mac-gpu.yml" ]; then
        rm docker-compose.mac-gpu.yml
    fi
    ln -s docker/docker-compose.mac-gpu.yml docker-compose.mac-gpu.yml
    echo -e "${GREEN}✅ Created symlink for docker-compose.mac-gpu.yml${NC}"
fi

echo ""
echo "=== Symlinks Created ==="
echo ""
echo "You can now use both paths for Docker Compose files:"
echo "- docker/docker-compose.yml (preferred)"
echo "- docker-compose.yml (legacy)"
echo ""
echo "However, we recommend using the Makefile commands whenever possible."
echo -e "${GREEN}make up${NC}         # Start development environment"
echo -e "${GREEN}make up-gpu${NC}      # Start with GPU support"
echo -e "${GREEN}make up-prod${NC}     # Start production environment"
echo "" 