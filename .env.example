# Onefold backend: copy to `.env` and fill in the values marked "change-me".
# docker compose reads this file; so does `python manage.py` if you export it.

# --- Django -------------------------------------------------------------------
DEBUG=1
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ----------------------------------------------------
# Without POSTGRES_DB the app falls back to SQLite (handy for quick local runs).
POSTGRES_DB=onefold
POSTGRES_USER=onefold
POSTGRES_PASSWORD=change-me
# Docker sets POSTGRES_HOST=db; use localhost when running Django on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache + Celery) ---------------------------------------------------
# Docker overrides this with redis://redis:6379/0. Leave empty to use an
# in-memory cache locally (Celery checks then need a running Redis).
REDIS_URL=redis://localhost:6379/0

# --- Web app & auth ------------------------------------------------------------
# Emailed links (sign-in, password reset, email confirmation) point to FRONTEND_URL.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
VERIFY_EMAIL_TTL_HOURS=72
# Failed password attempts per email before a lockout, and how long it lasts.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Requests per IP to the sign-in endpoints.
THROTTLE_AUTH=30/min
# Production: how many proxies append to X-Forwarded-For in front of the API
# (load balancer = 1), so rate limits use the real client IP. Leave unset locally.
# NUM_PROXIES=1

# Sign in with GitHub / Google: offered only when both values are set.
# Register this callback URL with the provider:
#   GitHub: FRONTEND_URL/api/auth/oauth/github/callback
#   Google: FRONTEND_URL/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email --------------------------------------------------------------------
# docker compose sends every email to Mailpit: open http://localhost:8025.
# Running Django without docker prints emails to the terminal instead.
# In production, set an SMTP provider (EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Onefold <hello@localhost>

# --- Onefold ------------------------------------------------------------------
LEARNING_DEFAULT_PATH=ship-your-first-product
# LEARNING_CONTENT_DIR=   # defaults to ./content
VERIFICATION_CHECKS_PER_MINUTE=10

# --- Demo data (development only) ----------------------------------------------
# docker compose seeds demo accounts on start. Sign in on the login page with
# one click ("Sign in as..."), or with the demo password. Set SEED_DEMO_DATA=0
# to skip. The seeder and demo sign-in refuse to run with DEBUG=0.
SEED_DEMO_DATA=1
SEED_DEMO_PASSWORD=onefold
SEED_ADMIN_PASSWORD=onefold
DEMO_LOGIN=1

# --- Ports on your machine (docker compose) -------------------------------------
# API_PORT=8000
# WEB_PORT=3000
# MAILPIT_PORT=8025
# POSTGRES_PORT_HOST=5432
# REDIS_PORT_HOST=6379
