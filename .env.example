# Onefold backend: copy to `.env` and fill in the values marked "change-me".
# docker compose reads this file; so does `python manage.py` if you export it.

# --- Django -------------------------------------------------------------------
DEBUG=1
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ----------------------------------------------------
# Without POSTGRES_DB the app falls back to SQLite (handy for quick local runs).
POSTGRES_DB=onefold
POSTGRES_USER=onefold
POSTGRES_PASSWORD=change-me
# Docker sets POSTGRES_HOST=db; use localhost when running Django on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache + Celery) ---------------------------------------------------
# Docker overrides this with redis://redis:6379/0. Leave empty to use an
# in-memory cache locally (Celery checks then need a running Redis).
REDIS_URL=redis://localhost:6379/0

# --- Web app & auth ------------------------------------------------------------
# Magic sign-in links point to FRONTEND_URL/auth/verify?token=...
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_COOLDOWN_SECONDS=60

# --- Email --------------------------------------------------------------------
# With DEBUG=1 emails (including sign-in links) print to the web container logs.
# In production, set an SMTP provider:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Onefold <hello@localhost>

# --- Onefold ------------------------------------------------------------------
LEARNING_DEFAULT_PATH=ship-your-first-product
# LEARNING_CONTENT_DIR=   # defaults to ./content
VERIFICATION_CHECKS_PER_MINUTE=10

# --- Demo data (development only) ----------------------------------------------
# docker compose seeds demo accounts on start; sign-in links print in `docker
# compose logs api`. Set to 0 to skip. The seeder refuses to run with DEBUG=0.
SEED_DEMO_DATA=1
SEED_ADMIN_PASSWORD=onefold

# --- Ports on your machine (docker compose) -------------------------------------
# API_PORT=8000
# WEB_PORT=3000
# POSTGRES_PORT_HOST=5432
# REDIS_PORT_HOST=6379
