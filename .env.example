# Onefold backend — environment variables
#
# Copy to `.env` at the repo root (docker compose reads ../.env from docker/).
# For running Django outside Docker, the settings loader reads `api/.env`;
# copy or symlink the same file there.
#
# Non-secret structure (DB/Redis hosts, Celery options) lives in api/docker/config.yml.
# Secrets and per-environment switches belong here. Never commit a real `.env`.

# --- Environment -------------------------------------------------------------
# ENV=1 → development settings, ENV=0 → production settings.
ENV=1
# Required in every environment; settings refuse to start without it.
DEBUG=1
LOG_LEVEL=INFO

# --- Django ------------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---------------------------------------------------
# Inside docker compose the database is reachable as `nevo_db`. Running Django
# on your machine against the compose database: DATABASE_HOST=localhost.
# (api/docker/config.yml says `db`, which no compose service answers to.)
DATABASE_HOST=nevo_db
DATABASE_INTERNAL_PORT=5432
# Port published on your machine by the postgres container.
DATABASE_PORT=5432
# The same values create the database in the postgres container.
DATABASE_NAME=noev
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
# Optional: a managed Postgres URL instead of the values above.
# NEON_DATABASE_URL=
# Optional TLS client certificates for managed databases.
# DB_SSL_ROOT_CERT_PATH=
# DB_SSL_CERT_PATH=
# DB_SSL_KEY_PATH=

# --- Redis (cache, Celery broker, Channels) ----------------------------------
# Inside docker compose: `nevo_redis`. On your machine: REDIS_HOST=localhost and
# REDIS_PORT=6380 (the port compose publishes). The dev Redis has no password.
REDIS_HOST=nevo_redis
REDIS_PASSWORD=
ENABLE_CACHE=true
# Managed Redis (DigitalOcean): set these and USE_DO_REDIS=true.
USE_DO_REDIS=false
# DO_REDIS_HOST=
# DO_REDIS_PORT=25061
# DO_REDIS_USERNAME=default
# DO_REDIS_PASSWORD=

# --- Email -------------------------------------------------------------------
# Magic links and nudges need one provider. Leave empty in local development.
SENDGRID_API_KEY=
SENDGRID_SENDER=
# MAILGUN_API_KEY=
# MAILGUN_SENDER_DOMAIN=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
OTP_DELIVERY_METHOD=email
OTP_EXPIRATION_MINS=10

# --- File storage (optional; local disk when empty) ---------------------------
# DO_SPACES_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DO_SPACES_BUCKET_NAME=
# DO_SPACES_REGION_NAME=

# --- Onefold: learning paths & verification ----------------------------------
# Path new builders are enrolled in (a directory under content/paths/).
LEARNING_DEFAULT_PATH=ship-your-first-product
# Content root; defaults to <repo>/content. Override for a separate content repo.
# LEARNING_CONTENT_DIR=
# "Check my work" requests allowed per builder per minute.
VERIFICATION_CHECKS_PER_MINUTE=10

# --- Docker / Makefile -------------------------------------------------------
PROJECT_NAME=noev
CONTAINER_SUFFIX=dev
API_PORT=8009
# REDIS_EXTERNAL_PORT=6380
# GUNICORN_WORKERS=2
# CELERY_WORKER_CONCURRENCY=8

# --- Inherited integrations (not used by Onefold) -----------------------------
# The kolct-era code also reads Twilio, Vonage, Neons SMS, Moyasar, Google
# Analytics and social-auth keys (TWILIO_*, VONAGE_*, NEONS_SMS_*, MOYASAR_*,
# GOOGLE_ANALYTICS_*, SOCIAL_AUTH_*). They're optional and can stay unset.
